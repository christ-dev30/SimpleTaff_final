# ============================================================
#   SimpleTaff — Template des variables d'environnement
#   Copiez ce fichier en .env et remplissez les valeurs
#   Ce fichier PEUT être commité sur Git (pas de secrets)
# ============================================================

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simpletaff_db
DB_USERNAME=postgres
DB_PASSWORD=VOTRE_MOT_DE_PASSE_DB

# --- JWT (générez une clé aléatoire de 64+ caractères hex) ---
JWT_SECRET=VOTRE_CLE_JWT_64_CHARS_HEX
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Email SMTP ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre.email@gmail.com
MAIL_PASSWORD=VOTRE_MOT_DE_PASSE_APPLICATION_GMAIL

# --- Serveur ---
SERVER_PORT=8080
APP_NAME=SimpleTaff

# --- Upload ---
MAX_FILE_SIZE=13MB
MAX_REQUEST_SIZE=13MB
